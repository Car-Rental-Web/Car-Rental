-- =====================================================================
-- WATER STATION: customer profile photo
-- Run this in the WATER Supabase project, SQL Editor.
-- =====================================================================

-- 1. New column on the customer table (stores the photo's public URL)
alter table public.water_customer
  add column if not exists profile_image text;

-- 2. The storage bucket: public (so the photo shows in the app),
--    images only, up to 10 MB. If you already made it by hand,
--    this just makes sure it is public.
insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values (
  'profile_image',
  'profile_image',
  true,
  10485760,
  array['image/png', 'image/jpeg', 'image/webp', 'image/gif']
)
on conflict (id) do update
  set public = true,
      file_size_limit = 10485760,
      allowed_mime_types = array['image/png', 'image/jpeg', 'image/webp', 'image/gif'];

-- 3. Who may change files in it: logged-in users only.
--    (Anyone can VIEW a photo through its public link, but only your
--    signed-in staff can upload, replace, or delete.)
drop policy if exists "profile_image staff select" on storage.objects;
drop policy if exists "profile_image staff insert" on storage.objects;
drop policy if exists "profile_image staff update" on storage.objects;
drop policy if exists "profile_image staff delete" on storage.objects;

create policy "profile_image staff select" on storage.objects
  for select to authenticated
  using (bucket_id = 'profile_image');

create policy "profile_image staff insert" on storage.objects
  for insert to authenticated
  with check (bucket_id = 'profile_image');

create policy "profile_image staff update" on storage.objects
  for update to authenticated
  using (bucket_id = 'profile_image')
  with check (bucket_id = 'profile_image');

create policy "profile_image staff delete" on storage.objects
  for delete to authenticated
  using (bucket_id = 'profile_image');